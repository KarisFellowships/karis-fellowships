# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Large local video (exceeds GitHub 100MB limit); hero uses TreeVideoClipped.mp4
public/treesvideo.mov

# .cursor reference materials (screenshots, specs, spreadsheets, recordings)
.cursor/*.jpg
.cursor/*.jpeg
.cursor/*.png
.cursor/*.mp4
.cursor/*.mov
.cursor/*.pdf
.cursor/*.xlsx
.cursor/~$*
.cursor/desktop.ini
.cursor/KF Weekly Meetings/
.cursor/NHG/

# Root-level recordings
Recording *.mp4

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
