# Karis Fellowships — environment variables.
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Full-access service role key — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
STRIPE_SECRET_KEY=sk_live_or_test_xxx
# From the Stripe webhook endpoint settings (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Resend (transactional email) ---
RESEND_API_KEY=re_xxx

# --- Operational alerts (optional; sensible defaults in src/lib/alerts.ts) ---
# ALERT_EMAIL=admin@karisfellowships.com
# ALERT_FROM=Karis Fellowships <noreply@karisfellowships.com>
